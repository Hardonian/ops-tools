{
  "name": "customer-api",
  "version": "1.0.0",
  "description": "RESTful HTTP API serving customer data for the commerce platform",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.5"
  },
  "overrides": {
    "body-parser@<1.20.6": "1.20.6",
    "brace-expansion@<1.1.18": "1.1.18",
    "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "minimatch@<3.1.4": "3.1.4",
    "minimatch@>=9.0.0 <9.0.7": "9.0.7"
  }
}
